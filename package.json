{
  "name": "cap-frontend-panda",
  "version": "0.1.0",
  "private": true,
  "description": "Panda CSS token toolchain for the Kodiak creative-automation frontier frontend. Generates typed design-system css custom properties from design/tokens/kodiak.json so agents cannot slop raw-hex CSS.",
  "type": "module",
  "scripts": {
    "tokens:config": "uv run python scripts/gen-panda-config.py",
    "tokens:css": "panda cssgen --outfile web/kodiak-posts-for-todays-frontier/design/styles.css",
    "build:ember": "node scripts/build-ember.mjs",
    "bundle:babylon": "node scripts/build-ember.mjs",
    "check:frontier": "tsc -p web/kodiak-posts-for-todays-frontier/js",
    "lint:css": "node scripts/lint-spacing-tokens.mjs",
    "test:vitest": "vitest run --exclude '**/.muse/**' tests/vitest/",
    "test:live": "node tests/live/harness.mjs",
    "test:render": "playwright test --config playwright.config.mjs"
  },
  "devDependencies": {
    "@babylonjs/core": "9.4.1",
    "@pandacss/dev": "1.12.0",
    "esbuild": "0.25.9",
    "playwright": "1.63.0",
    "vitest": "5.0.0"
  }
}
