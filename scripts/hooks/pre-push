#!/usr/bin/env bash
#
# fast local pre-push check; the full local gate runs before merge
# this hook runs pinned local lint only; all other checks stay in full-check.sh
# ---------------------------------------------------------------------------
# this hook is the CI. there is no server-side CI on this repo.
# local pre-push hook runs pinned lint only; the full local gate is explicit
# no hosted CI service, build definition, or remote browser is invoked here
#
# this hook runs ONLY the fast lint gate so a push never waits on the 250s test
# suite -- a heavy per-push gate just gets --no-verify'd into uselessness.
#   gate  uvx ruff@0.15.12 check .   (lint, ~1s)
#
# the full suite (pytest + cfn-lint) is a DELIBERATE checkpoint, not a per-push
# tax. run it before opening/merging a PR:
#   uv run --with pytest pytest -x -q
#   cfn-lint infra/template.yaml
# (or run scripts/hooks/full-check.sh)
#
# ruff failure prints "PUSH BLOCKED: ruff failed" and exits non-zero.
#
# activation (fresh clone, one command):
#   scripts/hooks/install.sh
# emergency bypass (sparingly, never on shared branches):
#   git push --no-verify
# ---------------------------------------------------------------------------
set -euo pipefail

repo_root="$(git rev-parse --show-toplevel)"
cd "$repo_root"

if ! command -v uvx >/dev/null 2>&1; then
  echo "PUSH BLOCKED: missing tool 'uvx' -- install with: curl -LsSf https://astral.sh/uv/install.sh | sh" >&2
  exit 1
fi

echo "pre-push gate: ruff (fast lint)"
if ! uvx ruff@0.15.12 check .; then
  echo "PUSH BLOCKED: ruff failed" >&2
  exit 1
fi

echo "pre-push gate: ruff clean -- push allowed; run scripts/hooks/full-check.sh before merge"
